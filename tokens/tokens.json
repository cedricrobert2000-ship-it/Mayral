{
  "$description": "MAYRAL — Private Office. Source unique de vérité (format W3C Design Tokens). Générer avec `npm run tokens`.",
  "color": {
    "$type": "color",
    "base": {
      "black-1000": { "$value": "#050304" },
      "black-950": { "$value": "#0A0607" },
      "black-900": { "$value": "#120A0B" },
      "black-800": { "$value": "#1B1011" },
      "black-700": { "$value": "#261618" },
      "crimson-900": { "$value": "#2A0709" },
      "crimson-800": { "$value": "#4A0B10" },
      "crimson-700": { "$value": "#6E0F16" },
      "crimson-600": { "$value": "#8F141C" },
      "red-500": { "$value": "#C81E24" },
      "red-400": { "$value": "#E2353A" },
      "glow-300": { "$value": "#FF5A4E" },
      "ash-400": { "$value": "#8C8283" },
      "ash-200": { "$value": "#CFC6C6" },
      "white-50": { "$value": "#F5F1EF" }
    },
    "semantic": {
      "bg-canvas": { "$value": "{color.base.black-1000}" },
      "bg-surface": { "$value": "{color.base.black-950}" },
      "bg-elevated": { "$value": "{color.base.black-900}" },
      "bg-tint": { "$value": "{color.base.crimson-900}" },
      "border-subtle": { "$value": "rgba(245,241,239,0.08)" },
      "border-strong": { "$value": "rgba(245,241,239,0.18)" },
      "text-primary": { "$value": "{color.base.white-50}" },
      "text-secondary": { "$value": "{color.base.ash-200}" },
      "text-muted": { "$value": "{color.base.ash-400}" },
      "accent-default": { "$value": "{color.base.red-500}" },
      "accent-hover": { "$value": "{color.base.red-400}" },
      "accent-glow": { "$value": "{color.base.glow-300}" },
      "state-focus": { "$value": "{color.base.glow-300}" },
      "state-success": { "$value": "#7FA88A" },
      "state-error": { "$value": "#E2353A" }
    }
  },
  "gradient": {
    "$type": "gradient",
    "overlay-hero": { "$value": "linear-gradient(180deg, rgba(5,3,4,0.35) 0%, rgba(5,3,4,0) 35%, rgba(5,3,4,0) 60%, rgba(5,3,4,0.9) 100%)" },
    "overlay-side": { "$value": "linear-gradient(90deg, rgba(5,3,4,0) 30%, rgba(5,3,4,0.85) 75%)" }
  },
  "font": {
    "$type": "fontFamily",
    "$description": "Option A validée. Alternative payante : Neue Montreal (Pangram Pangram) pour le texte.",
    "display": { "$value": "var(--font-manrope), system-ui, sans-serif" },
    "sans": { "$value": "var(--font-manrope), system-ui, sans-serif" },
    "label": { "$value": "var(--font-unbounded), system-ui, sans-serif" }
  },
  "type": {
    "$type": "typography",
    "$description": "Échelle fluide 375 → 1440 px. min/max en px.",
    "display-xl": { "$value": { "min": 40, "max": 88, "lhMin": 1.05, "lhMax": 1.0, "weight": 300, "tracking": "-0.03em" } },
    "display-l": { "$value": { "min": 32, "max": 64, "lhMin": 1.1, "lhMax": 1.05, "weight": 300, "tracking": "-0.025em" } },
    "display-m": { "$value": { "min": 28, "max": 48, "lhMin": 1.15, "lhMax": 1.1, "weight": 300, "tracking": "-0.02em" } },
    "heading": { "$value": { "min": 20, "max": 28, "lhMin": 1.3, "lhMax": 1.25, "weight": 400, "tracking": "-0.01em" } },
    "body-l": { "$value": { "min": 16, "max": 19, "lhMin": 1.6, "lhMax": 1.6, "weight": 400, "tracking": "0" } },
    "body": { "$value": { "min": 15, "max": 16, "lhMin": 1.6, "lhMax": 1.65, "weight": 400, "tracking": "0" } },
    "label": { "$value": { "min": 11, "max": 12, "lhMin": 1.2, "lhMax": 1.2, "weight": 500, "tracking": "0.22em" } },
    "spec": { "$value": { "min": 13, "max": 14, "lhMin": 1.4, "lhMax": 1.4, "weight": 400, "tracking": "0" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" },
    "6": { "$value": "24px" }, "8": { "$value": "32px" }, "12": { "$value": "48px" }, "16": { "$value": "64px" },
    "24": { "$value": "96px" }, "32": { "$value": "128px" }, "48": { "$value": "192px" }
  },
  "layout": {
    "$type": "dimension",
    "max-width": { "$value": "1600px" },
    "margin-mobile": { "$value": "20px" }, "margin-tablet": { "$value": "40px" }, "margin-desktop": { "$value": "64px" },
    "gutter-mobile": { "$value": "16px" }, "gutter-tablet": { "$value": "20px" }, "gutter-desktop": { "$value": "24px" },
    "section-mobile": { "$value": "96px" }, "section-desktop": { "$value": "160px" }
  },
  "radius": {
    "$type": "dimension",
    "card": { "$value": "8px" },
    "pill": { "$value": "999px" }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "375px" }, "md": { "$value": "768px" }, "lg": { "$value": "1024px" }, "xl": { "$value": "1280px" }, "2xl": { "$value": "1600px" }
  },
  "motion": {
    "ease-out": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
    "ease-inout": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1] },
    "duration-fast": { "$type": "duration", "$value": "200ms" },
    "duration-base": { "$type": "duration", "$value": "700ms" },
    "duration-slow": { "$type": "duration", "$value": "1400ms" }
  }
}
